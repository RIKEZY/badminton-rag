# ===== 生成模型（OpenAI 兼容协议）=====
DEEPSEEK_API_KEY=
# 官方：https://api.deepseek.com
# 中转站：填中转站地址，通常需要以 /compatible-mode/v1 结尾
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
# 关闭推理型模型的思考阶段（仅部分供应商支持，如硅基流动的 DeepSeek-V4-Flash）
# 官方 deepseek-chat 本身不思考，填不填都一样
CHAT_DISABLE_THINKING=true

# ===== Embedding（硅基流动，https://cloud.siliconflow.cn 注册后创建 Key）=====
# 模型用 BAAI/bge-m3，多语言，模型本身免费
# DeepSeek 官方不提供 embedding 接口，所以向量化必须走第三方
SILICONFLOW_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
